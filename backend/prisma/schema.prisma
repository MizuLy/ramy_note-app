// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // url = env("DOCKER_URL")
}

model Users {
  id        String @id @default(uuid())
  name      String
  email     String @unique
  password  String
  image     String?
  role      RoleList @default(USER)
  isVerified Boolean @default(false)
  createdAt DateTime @default(now())

  notes Notes[] @relation("Owner")
  editableNotes Notes[] @relation("Editor")
  folders Folders[]
  tags Tags[]
  journals Journals[]
  todos Todos[]
}

model Notes {
  id        String @id @default(uuid())
  userId    String
  folderId  String?
  title     String?
  body      String?
  isPinned  Boolean @default(false)
  isDeleted Boolean @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())

  user Users @relation("Owner",fields: [userId], references: [id], onDelete: Cascade)
  editors Users[] @relation("Editor")
  tags Tags[]
  folder Folders? @relation(fields: [folderId], references: [id], onDelete: SetNull)
}

model Todos {
  id        String @id @default(uuid())
  userId    String
  title     String
  isDone    Boolean @default(false)
  dueDate   DateTime?
  createdAt DateTime @default(now())

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Journals {
  id        String @id @default(uuid())
  userId    String
  title     String?
  body      String
  mood      Mood?
  isDeleted Boolean @default(false)
  deletedAt DateTime?
  entryDate DateTime @default(now())
  createdAt DateTime @default(now())

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Tags{
  id        String @id @default(uuid())
  userId    String
  tag       String
  createdAt DateTime @default(now())

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes Notes[]

  @@unique([tag, userId])
}

model Folders{
  id        String @id @default(uuid())
  name      String
  userId    String
  createdAt DateTime @default(now())
  
  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)
  note Notes[]
}

model Otps {
  id String @id @default(uuid())
  email String
  otp String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model ResetTokens {
  id      String @id @default(uuid())
  email   String
  token   String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum RoleList{
  ADMIN
  USER
}

enum Mood {
  HAPPY
  SAD
  TIRED
  ANXIOUS
  EXCITED
  NEUTRAL
}